{
    "manifest_version": 3,
    "name": "YT Timestamp Bookmarks",
    "version": "1.0.0",
    "description": "Save and revisit YouTube timestamps.",
    "permissions": [
        "storage"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "YTMark.png",
            "32": "YTMark.png",
            "48": "YTMark.png",
            "128": "YTMark.png"
        }
    },
    "icons": {
        "16": "YTMark.png",
        "32": "YTMark.png",
        "48": "YTMark.png",
        "128": "YTMark.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.youtube.com/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}