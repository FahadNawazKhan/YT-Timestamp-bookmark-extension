{
    "manifest_version" : 3,
    "name":"YT Timestamp Bookmarks",
    "version":"1.0.0",
    "description":"Save and revisit YouTube timestamps.",
    "permissions":[
        "storage",
        "tabs"
    ],
    "action":{
        "default_popup":"popup.html"
    },
    "content_scripts":[
        {
            "matches":[
                "https://www.youtube.com/*"
            ],
            "js":[
                "content.js"
            ]
        }
    ]
}